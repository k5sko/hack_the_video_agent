  "clips": [
    {
      "id": "v1_c1",
      "video_id": "V1",
      "start": 65,
      "end": 205,
      "summary": "What a neuron is, what a layer is, and how a network is just a function from 784 numbers to 10 numbers."
    },
    {
      "id": "v1_c2",
      "video_id": "V1",
      "start": 205,
      "end": 355,
      "summary": "Why there are hidden layers at all, and the hope that each one picks up edges then loops then digits."
    },
    {
      "id": "v1_c3",
      "video_id": "V1",
      "start": 430,
      "end": 580,
      "summary": "Weights and biases written as a weighted sum, then compressed into a single matrix-vector product."
    },
    {
      "id": "v1_c4",
      "video_id": "V1",
      "start": 640,
      "end": 760,
      "summary": "Squishing the weighted sum into a range with sigmoid, and why modern networks use ReLU instead."
    },
    {
      "id": "v2_c1",
      "video_id": "V2",
      "start": 95,
      "end": 250,
      "summary": "Defining a cost function over the training data: the average squared error of the network's output."
    },
    {
      "id": "v2_c2",
      "video_id": "V2",
      "start": 300,
      "end": 470,
      "summary": "Walking downhill on the cost surface, and the gradient as the direction of steepest ascent."
    },
    {
      "id": "v2_c3",
      "video_id": "V2",
      "start": 520,
      "end": 640,
      "summary": "Step size and the learning rate: why steps shrink as the slope flattens out."
    },
    {
      "id": "v2_c4",
      "video_id": "V2",
      "start": 700,
      "end": 840,
      "summary": "The gradient spelled out as a vector of partial derivatives, one per weight and bias."
    },
    {
      "id": "v3_c1",
      "video_id": "V3",
      "start": 60,
      "end": 220,
      "summary": "Backpropagation as the intuition of nudging every weight in proportion to how much it would help."
    },
    {
      "id": "v3_c2",
      "video_id": "V3",
      "start": 260,
      "end": 420,
      "summary": "Propagating desired changes backwards layer by layer through the computational graph."
    },
    {
      "id": "v4_c1",
      "video_id": "V4",
      "start": 40,
      "end": 160,
      "summary": "A refresher on derivatives as limits of tiny nudges, dC over dw, before any network appears."
    },
    {
      "id": "v4_c2",
      "video_id": "V4",
      "start": 210,
      "end": 380,
      "summary": "The chain rule applied through a one-neuron-per-layer network, multiplying sensitivities together."
    },
    {
      "id": "v4_c3",
      "video_id": "V4",
      "start": 430,
      "end": 560,
      "summary": "Partial derivatives of a multivariable cost with respect to each individual weight."
    },
    {
      "id": "v5_c1",
      "video_id": "V5",
      "start": 120,
      "end": 250,
      "summary": "Breaking text into tokens, and why tokens are not the same thing as words."
    },
    {
      "id": "v5_c4",
      "video_id": "V5",
      "start": 730,
      "end": 880,
      "summary": "The embedding matrix: every token becomes a high-dimensional vector whose directions carry meaning."
    },
    {
      "id": "v5_c6",
      "video_id": "V5",
      "start": 1100,
      "end": 1200,
      "summary": "Turning the final logits into a probability distribution with softmax and its exponentials."
    },
    {
      "id": "v5_c8",
      "video_id": "V5",
      "start": 1330,
      "end": 1480,
      "summary": "Assembling the whole transformer: alternating attention blocks and multilayer perceptron blocks."
    },
    {
      "id": "v6_c1",
      "video_id": "V6",
      "start": 45,
      "end": 175,
      "summary": "Dot products between embedding vectors as a measure of how much one word attends to another."
    },
    {
      "id": "v6_c2",
      "video_id": "V6",
      "start": 220,
      "end": 535,
      "summary": "The attention pattern itself: scores over all previous tokens, normalised into weights."
    },
    {
      "id": "v6_c3",
      "video_id": "V6",
      "start": 535,
      "end": 720,
      "summary": "Query, key and value matrices, and the matrix multiplications that produce them."
    },
    {
      "id": "v7_c1",
      "video_id": "V7",
      "start": 30,
      "end": 170,
      "summary": "What a vector actually is: an arrow, a list of numbers, and the thing all of linear algebra acts on."
    },
    {
      "id": "v7_c2",
      "video_id": "V7",
      "start": 200,
      "end": 350,
      "summary": "Basis vectors, span, and why every vector is a linear combination of i-hat and j-hat."
    },
    {
      "id": "v7_c3",
      "video_id": "V7",
      "start": 380,
      "end": 540,
      "summary": "Linear transformations as grid-preserving movements of space, tracked by where the basis lands."
    },
    {
      "id": "v7_c4",
      "video_id": "V7",
      "start": 600,
      "end": 760,
      "summary": "Matrix multiplication as the composition of two linear transformations, applied right to left."
    },
    {
      "id": "v7_c5",
      "video_id": "V7",
      "start": 800,
      "end": 930,
      "summary": "The dot product geometrically: projection times length, and why order does not matter."
    }
